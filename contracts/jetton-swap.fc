;; Jetton Wallet Smart Contract

#pragma version >=0.4.3;

#include "stdlib.fc";
#include "op-codes.fc";
#include "workchain.fc";
#include "jetton-utils.fc";
#include "gas.fc";

{-
  Storage

  Note, status is always equal 0 and unused for now.

  storage#_ owner_address:MsgAddressInt jetton_wallet_address:MsgAddressInt
            jetton_master_address:MsgAddressInt = Storage;
-}

const const::token_price = 1; ;; 1 NanoTON
const const::token_storage_fee = 48000000; ;; 0.048 TON
const const::mint_fee = 10000000; ;; 0.01 TON
const const::min_tons_for_storage = 10000000; ;; 0.01 TON

(slice, slice, slice, int) load_data() inline {
    slice ds = get_data().begin_parse();
    var data = (
        ds~load_msg_addr(), ;; owner_address
        ds~load_msg_addr(), ;; jetton_wallet_address
        ds~load_msg_addr(), ;; jetton_master_address
        ds~load_coins() ;; jetton balance
    );
    ds.end_parse();
    return data;
}

() save_data(slice owner_address, slice jetton_wallet_address, slice jetton_master_address, int jetton_balance) impure inline {
    set_data(begin_cell()
        .store_slice(owner_address)
        .store_slice(jetton_wallet_address)
        .store_slice(jetton_master_address)
        .store_coins(jetton_balance)
        .end_cell());
}
;; TODO: on_bounce()

() recv_internal(int my_ton_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return (); ;; Just accept TON deposit
    }
    slice in_msg_full_slice = in_msg_full.begin_parse();
    int msg_flags = in_msg_full_slice~load_msg_flags();
    if (msg_flags & 1) { ;; is bounced
        return ();
    }
    slice sender_address = in_msg_full_slice~load_msg_addr();
    ;; int fwd_fee_from_in_msg = in_msg_full_slice~retrieve_fwd_fee();
    ;; int fwd_fee = get_original_fwd_fee(MY_WORKCHAIN, fwd_fee_from_in_msg); ;; we use message fwd_fee for estimation of forward_payload costs
    (slice owner_address, slice wallet_address, slice jetton_master_address, int jetton_balance) = load_data();
    int op = in_msg_body~load_op();

   
    if (op == op::change_wallet_addr) {
        throw_unless(error::not_owner, equal_slices_bits(sender_address, owner_address));
        in_msg_body~skip_bits(64); ;; query id
        slice new_wallet_address = in_msg_body~load_msg_addr();
        int j_balance = in_msg_body~load_coins();
        save_data(owner_address, new_wallet_address, jetton_master_address, j_balance);
        return();
    }
    
    if (op == op::swap) {
        throw_unless(error::not_enough_gas, (msg_value > const::token_storage_fee + const::mint_fee));
        int jetton_amount = msg_value - const::token_storage_fee - const::mint_fee;
        throw_unless(error::balance_error, jetton_amount <= jetton_balance);
        int query_id = in_msg_body~load_query_id();
        var jetton_transfer_body = begin_cell()
            .store_uint(op::transfer, 32)
            .store_query_id(query_id) ;; query_id
            .store_coins(jetton_amount)
            .store_slice(sender_address) ;; destination:MsgAddress
            .store_slice(my_address()) ;; response_destination:MsgAddress
            .store_uint(0, 1) ;; custom payload:(Maybe ^Cell) - nothing
            .store_coins(12) ;; forward_ton amount
            .store_uint(0, 1) ;; forward_payload:(Either Cell ^Cell) - left Cell
            .end_cell();
        
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(wallet_address)
            .store_coins(const::min_tons_for_storage + const::mint_fee) ;; msg_value for jetton transfer
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1) ;; extra currencies, ihr_fee, fwd_fee, created_lt, created_at
            .store_uint(1, 1)
            .store_ref(jetton_transfer_body)      ;; message body as reference
            .end_cell();

        send_raw_message(msg, 17); ;; separate fees and bounce on action error
        jetton_balance -= jetton_amount;
        save_data(owner_address, wallet_address, jetton_master_address, jetton_balance);
        return ();
    }

    if (op == op::withdraw_tons) {
        throw_unless(error::not_owner, equal_slices_bits(sender_address, owner_address));
        in_msg_body~skip_bits(64); ;; query id
        int withdraw_amount = in_msg_body~load_coins();
        var [balance, _] = get_balance();
        int return_value = min(withdraw_amount, balance - const::min_tons_for_storage);

        int msg_mode = 1; ;; 0 (Ordinary message) + 1 (Pay transfer fees separately from the message value)

        var msg = begin_cell()
              .store_uint(0x18, 6)
              .store_slice(sender_address)
              .store_coins(return_value)
              .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1);
        send_raw_message(msg.end_cell(), msg_mode);
        return();
    }

    if (op == op::upgrade) {
        throw_unless(error::not_owner, equal_slices_bits(sender_address, owner_address));
        cell new_code = in_msg_body~load_ref();
        in_msg_body.end_parse();
        set_code(new_code);
        return ();
    }

    throw(error::wrong_op);
}

(slice, slice, slice, int) get_jswap_data() method_id {
    (slice owner_address, slice jetton_wallet_address, slice jetton_master_address, int jetton_balance) = load_data();
    return (owner_address, jetton_wallet_address, jetton_master_address, jetton_balance);
}


